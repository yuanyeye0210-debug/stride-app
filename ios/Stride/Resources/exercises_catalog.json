[{"id":"barbell-bench-press","name":"Barbell Bench Press","nameZH":"杠铃平板卧推","bodyPart":"chest","equipment":"barbell","target":"pectoralis_major","secondary":["triceps_brachii","anterior_deltoid"],"steps":["仰卧在平板卧推凳上，双脚稳踩地面，收紧肩胛骨贴紧凳面形成自然微弓。","双手略宽于肩握住杠铃杆，将杠铃推至胸部正上方锁定作为起始位置。","吸气并有控制地将杠铃下放至下胸位置，手肘呈约 45 度角。","呼气发力将杠铃垂直向上推回起始高度，保持肩部下沉不借力抬臀。"],"tips":["手肘内收约 45° 保护肩关节","肩胛骨全程保持后缩下沉","下放慢、推起稳，避免杠铃弹胸"],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/barbell-bench-press.mp4","localThumb":"vthumb_barbell-bench-press"},{"id":"incline-dumbbell-press","name":"Incline Dumbbell Press","nameZH":"上斜哑铃卧推","bodyPart":"chest","equipment":"dumbbell","target":"pectoralis_major","secondary":["anterior_deltoid","triceps_brachii"],"steps":["将靠背凳调至 30–45 度上斜角，双脚稳踩地面，双手持哑铃推至上胸正上方。","弯曲手肘约 45 度角，有控制地将哑铃向两侧下放至上胸外侧充分拉伸。","胸大肌上束发力，沿微向内收的弧线将哑铃推回顶端起始位置。"],"tips":["凳角不宜超过 45°，以免过多代偿前束","全程保持前臂垂直于地面"],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/incline-dumbbell-press.mp4","localThumb":"vthumb_incline-dumbbell-press"},{"id":"cable-chest-fly","name":"Cable Chest Fly","nameZH":"龙门架绳索夹胸","bodyPart":"chest","equipment":"cable","target":"pectoralis_major","secondary":["anterior_deltoid"],"steps":["站在双柱龙门架中央前迈一步呈微弓箭步，双手抓握与胸同高两侧拉环，双臂打开微屈。","保持手肘角度固定，胸部发力将双臂向前下方环抱，双手在胸前中线会合挤压胸肌。","有控制地缓慢张开双臂回到胸部充分拉伸的起始位置。"],"tips":["想象用肘部环抱大树，避免手臂变成推举","顶峰会合时停顿 1 秒感受胸肌收缩"],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/cable-chest-fly.mp4","localThumb":"vthumb_cable-chest-fly"},{"id":"push-up","name":"Push-Up","nameZH":"标准俯卧撑","bodyPart":"chest","equipment":"body weight","target":"pectoralis_major","secondary":["triceps_brachii","anterior_deltoid","rectus_abdominis"],"steps":["双手略宽于肩撑地，指尖朝前，从头到脚踝保持一条紧绷直线。","收紧核心与臀部，手肘向后斜 45 度屈曲缓慢下放身体至胸部接近地面。","发力推起身体回到双臂伸直的起始位，全程不塌腰不撅臀。"],"tips":["核心全程收紧维持平板刚性","肘关节不要向外完全打开成 T 字形"],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/push-up.mp4","localThumb":"vthumb_push-up"},{"id":"dumbbell-bench-press","name":"Dumbbell Bench Press","nameZH":"哑铃平板卧推","bodyPart":"chest","equipment":"dumbbell","target":"pectoralis_major","secondary":["triceps_brachii","anterior_deltoid"],"steps":["从胸部中段向上推举，手腕叠放在肘部上方","将肩胛骨固定在训练凳上","降低两秒，按下不弹起"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/dumbbell-bench-press.mp4","localThumb":"vthumb_dumbbell-bench-press"},{"id":"incline-bench-press","name":"Incline Bench Press","nameZH":"上斜杠铃卧推","bodyPart":"chest","equipment":"barbell","target":"pectoralis_major","secondary":["anterior_deltoid","triceps_brachii"],"steps":["将训练凳设置为 30-45 度","将杠铃触碰上胸部","将杠铃向上推并稍微向后推"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/incline-bench-press.mp4","localThumb":"vthumb_incline-bench-press"},{"id":"exercise-ball-dumbbell-bench-press","name":"Stability Ball Dumbbell Press","nameZH":"瑞士球哑铃卧推","bodyPart":"chest","equipment":"dumbbell","target":"pectoralis_major","secondary":["rectus_abdominis","triceps_brachii"],"steps":["将头和上背部放在球上，臀部保持水平","挤压臀部肌群以保持平坦的桥梁","将哑铃举过胸部"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/exercise-ball-dumbbell-bench-press.mp4","localThumb":"vthumb_exercise-ball-dumbbell-bench-press"},{"id":"chest-dip","name":"Chest Dip","nameZH":"双杠臂屈伸（练胸）","bodyPart":"chest","equipment":"dip station","target":"pectoralis_major","secondary":["triceps_brachii","anterior_deltoid"],"steps":["躯干稍微向前倾斜","降低直到肩膀略低于肘部","向上按而不用力锁定"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/pectoralis-major.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/chest-dip.mp4","localThumb":"vthumb_chest-dip"},{"id":"seated-dumbbell-shoulder-press","name":"Seated Dumbbell Shoulder Press","nameZH":"坐姿哑铃推举","bodyPart":"shoulders","equipment":"dumbbell","target":"anterior_deltoid","secondary":["lateral_deltoid","triceps_brachii"],"steps":["靠背凳调至近垂直 85°，双脚踩实地面，背部贴紧靠背，双手持哑铃于双耳两侧。","保持手腕中立、前臂垂直地面，垂直向上推起哑铃至头顶上方接近伸直。","顶峰短暂停留后缓慢受控下放回到耳侧高度。"],"tips":["肘部略微前移约 15–30° 处于肩胛骨平面更舒适","不要过度挺腰离开靠背"],"gif":"","thumb":"","muscleImage":"images/muscles/anterior-deltoid.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/seated-dumbbell-shoulder-press.mp4","localThumb":"vthumb_seated-dumbbell-shoulder-press"},{"id":"dumbbell-front-raise","name":"Dumbbell Front Raise","nameZH":"哑铃前平举","bodyPart":"shoulders","equipment":"dumbbell","target":"anterior_deltoid","secondary":["pectoralis_major"],"steps":["站姿核心收紧，双手正握哑铃自然垂于大腿前外侧，手肘微屈。","躯干保持稳定不后仰，沿前方弧线将哑铃平举至与肩同高水平。","短暂停顿后有控制地缓慢下放回到大腿前侧起始位置。"],"tips":["切勿甩腰晃动借力","举至肩高即可，避免过高引发斜方肌代偿"],"gif":"","thumb":"","muscleImage":"images/muscles/anterior-deltoid.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/dumbbell-front-raise.mp4","localThumb":"vthumb_dumbbell-front-raise"},{"id":"cable-lateral-raise","name":"Cable Lateral Raise","nameZH":"单臂绳索侧平举","bodyPart":"shoulders","equipment":"cable","target":"lateral_deltoid","secondary":["trapezius"],"steps":["侧站在低位滑轮旁，近侧手扶稳器械立柱，远侧手握住拉环起始于大腿前侧。","保持身体直立不侧歪，肩部中束发力将手臂向外侧平滑抬起至与肩同高。","顶峰停顿后缓慢对抗阻力放回起始位，确保绳索全程保持张力。"],"tips":["手肘略高于手腕，肩胛下沉不耸肩","相比哑铃，绳索能提供底部与全程持续张力"],"gif":"","thumb":"","muscleImage":"images/muscles/lateral-deltoid.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/cable-lateral-raise.mp4","localThumb":"vthumb_cable-lateral-raise"},{"id":"military-press","name":"Overhead Press","nameZH":"杠铃站姿推举","bodyPart":"shoulders","equipment":"barbell","target":"anterior_deltoid","secondary":["triceps_brachii","trapezius"],"steps":["每次重复前收紧腹肌并挤压臀部肌群","沿着脸部直线推举","最后以耳朵旁边的肱二头肌结束"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/anterior-deltoid.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/military-press.mp4","localThumb":"vthumb_military-press"},{"id":"lateral-raise","name":"Dumbbell Lateral Raise","nameZH":"哑铃侧平举","bodyPart":"shoulders","equipment":"dumbbell","target":"lateral_deltoid","secondary":["anterior_deltoid"],"steps":["站立，将哑铃放在身体两侧。","将哑铃向两侧举起，直到手臂与地板平行。","下降得到控制。","重复。"],"tips":["肘部柔软弯曲","抬高至肩高，用肘部引导","慢慢下降，不要晃动","肘部稍微弯曲。","用肘部引导，而不是用手。"],"gif":"images/flat/lateral-raise-peak.webp","thumb":"images/flat/lateral-raise-start.webp","muscleImage":"images/muscles/lateral-deltoid.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/dumbbell-lateral-raise.mp4","localThumb":"vthumb_dumbbell-lateral-raise"},{"id":"bent-over-low-pulley-rear-delt-fly","name":"Cable Rear Delt Fly","nameZH":"绳索俯身飞鸟（后束）","bodyPart":"shoulders","equipment":"cable","target":"posterior_deltoid","secondary":["rhomboids"],"steps":["屈髋俯身并保持背部平直","双臂以弧线扫过","当双手到达肩线时暂停"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/posterior-deltoid.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/bent-over-low-pulley-rear-delt-fly.mp4","localThumb":"vthumb_bent-over-low-pulley-rear-delt-fly"},{"id":"rope-tricep-pushdown","name":"Rope Tricep Pushdown","nameZH":"绳索双头绳三头下压","bodyPart":"upper arms","equipment":"cable","target":"triceps_brachii","secondary":[],"steps":["面对高位滑轮站立，上身微前倾，大臂紧贴身体两侧，双肘屈成约 90 度握住绳头。","保持大臂绝对固定，仅通过肘关节伸直将绳索向下压到底部并顺势向两侧微劈开。","顶峰挤压肱三头肌后受控弯曲手肘回到 90 度位置。"],"tips":["大臂夹紧躯干不前后摆动","底部向外拨开绳头能更充分收缩外侧头"],"gif":"","thumb":"","muscleImage":"images/muscles/triceps-brachii.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/rope-tricep-pushdown.mp4","localThumb":"vthumb_rope-tricep-pushdown"},{"id":"dumbbell-bicep-curl","name":"Alternating Dumbbell Bicep Curl","nameZH":"站姿哑铃交替弯举","bodyPart":"upper arms","equipment":"dumbbell","target":"biceps_brachii","secondary":["brachialis","forearm_flexors"],"steps":["自然站立双脚与肩同宽，大臂贴紧体侧，双手对握哑铃垂于身体两侧。","单侧手臂向上弯举同时手腕逐渐旋外至掌心朝上，顶峰收缩二头肌。","有控制地缓慢下放还原后换另一侧交替进行，保持躯干稳定不晃动。"],"tips":["手肘固定在体侧勿大幅前移","上举时顺势旋外手腕最大化刺激二头肌峰"],"gif":"","thumb":"","muscleImage":"images/muscles/biceps-brachii.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/dumbbell-bicep-curl.mp4","localThumb":"vthumb_dumbbell-bicep-curl"},{"id":"dumbbell-hammer-curl","name":"Dumbbell Hammer Curl","nameZH":"站姿哑铃锤式弯举","bodyPart":"upper arms","equipment":"dumbbell","target":"biceps_brachii","secondary":["forearm_flexors"],"steps":["站姿持哑铃垂于两侧，采用中立对握握法（大拇指朝前，掌心相对）。","全程保持手腕中立不旋转，同时将哑铃向上弯举至前臂贴近二头肌。","顶峰挤压肱肌与肱桡肌后，受控下放回到垂直悬垂位置。"],"tips":["手腕锁紧中立位不要翻腕","对增厚手臂围度与前臂外侧非常有效"],"gif":"","thumb":"","muscleImage":"images/muscles/biceps-brachii.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/dumbbell-hammer-curl.mp4","localThumb":"vthumb_dumbbell-hammer-curl"},{"id":"close-grip-bench-press","name":"Close-Grip Bench Press","nameZH":"窄距杠铃卧推","bodyPart":"upper arms","equipment":"barbell","target":"triceps_brachii","secondary":["anterior_deltoid","pectoralis_major"],"steps":["躺在平坦的训练凳上，双手与肩同宽握住杠铃。","将杠铃降低到下胸部，保持肘部靠近身体两侧。","向上按至完全伸展。","重复。"],"tips":["双手分开与肩同宽","保持肘部靠近身体","触摸下胸部，按下锁定","保持肘部内收以最大限度地激活肱三头肌。","避免握得太窄，以防止手腕拉伤。"],"gif":"images/flat/close-grip-bench-press-peak.webp","thumb":"images/flat/close-grip-bench-press-start.webp","muscleImage":"images/muscles/triceps-brachii.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/close-grip-bench-press.mp4","localThumb":"vthumb_close-grip-bench-press"},{"id":"ez-bar-skullcrusher","name":"EZ Bar Skullcrusher","nameZH":"曲杆仰卧臂屈伸（碎颅者）","bodyPart":"upper arms","equipment":"ez barbell","target":"triceps_brachii","secondary":[],"steps":["上臂保持垂直","将杠铃降低至前额","仅通过肘部延伸"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/triceps-brachii.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/ez-bar-skullcrusher.mp4","localThumb":"vthumb_ez-bar-skullcrusher"},{"id":"weighted-tricep-dips","name":"Weighted Tricep Dip","nameZH":"负重双杠臂屈伸（三头）","bodyPart":"upper arms","equipment":"dip station","target":"triceps_brachii","secondary":["pectoralis_major"],"steps":["保持躯干直立","肘部角度降低至 90 度","向上推举并锁定肱三头肌"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/triceps-brachii.webp","difficulty":"advanced","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/weighted-tricep-dips.mp4","localThumb":"vthumb_weighted-tricep-dips"},{"id":"barbell-curl","name":"Barbell Curl","nameZH":"站姿杠铃二头弯举","bodyPart":"upper arms","equipment":"barbell","target":"biceps_brachii","secondary":["brachialis","forearm_flexors"],"steps":["站立，手握杠铃，反手握距与肩同宽。","将杠铃向上弯向肩膀。","在顶部挤压，然后有控制地降低。","重复。"],"tips":["肘部保持固定在两侧","弯举而不向后倾斜","一直降低至完全伸展","避免摆动躯干。","将肘部固定在身体两侧。"],"gif":"images/flat/barbell-curl-peak.webp","thumb":"images/flat/barbell-curl-start.webp","muscleImage":"images/muscles/biceps-brachii.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/standing-barbell-curl.mp4","localThumb":"vthumb_standing-barbell-curl"},{"id":"incline-dumbbell-curl","name":"Incline Dumbbell Curl","nameZH":"上斜哑铃弯举","bodyPart":"upper arms","equipment":"dumbbell","target":"biceps_brachii","secondary":[],"steps":["让手臂笔直地垂在躯干后面","弯举时保持肘部不动","顶峰用力，慢慢放下"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/biceps-brachii.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/incline-dumbbell-curl.mp4","localThumb":"vthumb_incline-dumbbell-curl"},{"id":"dumbbell-hammer-preacher-curl","name":"Hammer Preacher Curl","nameZH":"牧师凳哑铃锤式弯举","bodyPart":"upper arms","equipment":"dumbbell","target":"biceps_brachii","secondary":["forearm_flexors"],"steps":["中立握法，拇指放在上面","腋窝紧贴护垫","停在距离顶部垂直线不远的地方"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/biceps-brachii.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/dumbbell-hammer-preacher-curl.mp4","localThumb":"vthumb_dumbbell-hammer-preacher-curl"},{"id":"barbell-wrist-curl","name":"Barbell Wrist Curl","nameZH":"坐姿杠铃腕弯举","bodyPart":"lower arms","equipment":"barbell","target":"forearm_flexors","secondary":[],"steps":["坐在训练凳上，前臂放在大腿上，掌心向上。","双手与肩同宽握住杠铃，手腕垂离膝盖。","让杠铃滚动到底部的指尖。","弯曲手腕，将杠铃向上弯举。","下降得到控制。"],"tips":["前臂放在大腿上，掌心向上","让杠铃滚动到指尖","手腕向上弯曲并挤压","仅移动手腕——保持前臂静止。","将杆滚动到指尖以获得全范围。","如果无拇指握法有助于手腕舒适，请使用无拇指握法。"],"gif":"images/flat/barbell-wrist-curl-peak.webp","thumb":"images/flat/barbell-wrist-curl-start.webp","muscleImage":"images/muscles/forearm-flexors.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/seated-barbell-wrist-curl.mp4","localThumb":"vthumb_seated-barbell-wrist-curl"},{"id":"reverse-grip-barbell-curl","name":"Reverse-Grip EZ Curl","nameZH":"曲杆反握弯举","bodyPart":"lower arms","equipment":"ez barbell","target":"forearm_flexors","secondary":["biceps_brachii"],"steps":["正手握住杠铃的倾斜部分","弯举时保持手腕处于中立位置","下限受控"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/forearm-flexors.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/reverse-grip-barbell-curl.mp4","localThumb":"vthumb_reverse-grip-barbell-curl"},{"id":"plate-pinch-carry","name":"Plate Pinch Carry","nameZH":"杠铃片捏握行走（抓握力）","bodyPart":"lower arms","equipment":"plates","target":"forearm_flexors","secondary":["trapezius"],"steps":["将两块板光滑的一面朝外捏","迈着小步，昂首阔步","在抓地力失效之前放下"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/forearm-flexors.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/plate-pinch-carry.mp4","localThumb":"vthumb_plate-pinch-carry"},{"id":"barbell-deadlift","name":"Barbell Deadlift","nameZH":"杠铃传统硬拉","bodyPart":"back","equipment":"barbell","target":"erector_spinae","secondary":["gluteus_maximus","hamstrings","latissimus_dorsi","trapezius"],"steps":["双脚与髋同宽站在杠铃前，杆位于脚背正上方，俯身屈髋屈膝握紧杠铃，挺胸平背。","吸气收紧核心，双脚蹬地同时伸髋伸膝，让杠铃贴近小腿和大腿垂直拉起至站直。","顶端锁髋挺胸短暂停留后，先屈髋后推臀部再屈膝，将杠铃沿腿部受控放回地面。"],"tips":["起拉前先拉紧杠铃消除松弛空隙","全程保持脊柱中立，杠铃紧贴身体重心线"],"gif":"","thumb":"","muscleImage":"images/muscles/erector-spinae.webp","difficulty":"advanced","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/barbell-deadlift.mp4","localThumb":"vthumb_barbell-deadlift"},{"id":"chin-up","name":"Chin-Up","nameZH":"反手引体向上","bodyPart":"back","equipment":"pull up bar","target":"latissimus_dorsi","secondary":["biceps_brachii","rhomboids"],"steps":["双手掌心朝向自己、约与肩同宽反握单杠，身体垂直悬垂，双脚微交叉。","下沉肩胛骨，弯曲肘部垂直向上拉起身体直至下巴越过横杠。","顶峰收缩背部与二头肌后，有控制地缓慢下放回到双臂完全伸直悬垂位。"],"tips":["避免利用下半身甩动借力","下放过程充分伸展背阔肌"],"gif":"","thumb":"","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/chin-up.mp4","localThumb":"vthumb_chin-up"},{"id":"one-arm-dumbbell-row","name":"One-Arm Dumbbell Row","nameZH":"单臂哑铃划船","bodyPart":"back","equipment":"dumbbell","target":"latissimus_dorsi","secondary":["rhomboids","biceps_brachii","posterior_deltoid"],"steps":["一侧膝盖与手掌支撑在平板凳上，另一脚稳踩地面，保持背部完全水平平直。","另一手垂直悬垂握住哑铃，背部发力带动手肘呈弧线向后上方拉向同侧髋部。","顶峰挤压背阔肌后受控垂直下放至手臂充分伸直。"],"tips":["划向髋部裤腰方向而非垂直拉向胸部","保持躯干稳定不大幅扭转借力"],"gif":"","thumb":"","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/one-arm-dumbbell-row.mp4","localThumb":"vthumb_one-arm-dumbbell-row"},{"id":"cable-face-pull","name":"Cable Face Pull","nameZH":"绳索面拉","bodyPart":"back","equipment":"cable","target":"posterior_deltoid","secondary":["rhomboids","trapezius"],"steps":["面对固定在头肩高度的绳索滑轮站稳，双手对握双头绳末端，双臂向前伸直拉紧。","肘部抬高与肩平齐，将绳索朝眉心和双耳两侧拉回，同时肩部外旋呈双肘展开姿态。","挤压后束与中下斜方肌 1 秒后，受控将双臂前送回到起始位。"],"tips":["大拇指朝后引导肩外旋，更好刺激后束与肩袖","不要耸肩或身体后仰借力"],"gif":"","thumb":"","muscleImage":"images/muscles/posterior-deltoid.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/cable-face-pull.mp4","localThumb":"vthumb_cable-face-pull"},{"id":"barbell-shrug","name":"Barbell Shrug","nameZH":"杠铃耸肩","bodyPart":"back","equipment":"barbell","target":"trapezius","secondary":[],"steps":["站直，双臂伸直","将肩膀抬向耳朵","保持一秒钟，不要滚动"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/trapezius.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/barbell-shrug.mp4","localThumb":"vthumb_barbell-shrug"},{"id":"dumbbell-shrug","name":"Dumbbell Shrug","nameZH":"哑铃耸肩","bodyPart":"back","equipment":"dumbbell","target":"trapezius","secondary":[],"steps":["哑铃放在两侧，中立握法","耸肩挺直","降低至完全伸展"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/trapezius.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/dumbbell-shrug.mp4","localThumb":"vthumb_dumbbell-shrug"},{"id":"barbell-upright-row","name":"Barbell Upright Row","nameZH":"杠铃直立划船","bodyPart":"back","equipment":"barbell","target":"trapezius","secondary":["anterior_deltoid"],"steps":["握距与肩同宽","以肘部为主导将杠铃向上拉","停在胸部较低的高度"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/trapezius.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/barbell-upright-row.mp4","localThumb":"vthumb_barbell-upright-row"},{"id":"seated-cable-row","name":"Seated Cable Row","nameZH":"坐姿绳索划船","bodyPart":"back","equipment":"cable","target":"latissimus_dorsi","secondary":["biceps_brachii","erector_spinae","posterior_deltoid"],"steps":["坐在电缆排站并将脚放在脚踏板上。","握住手柄并坐直，稍微前倾。","将肘部向后推，并将手柄拉向下腹部。","在拉力结束时将肩胛骨挤压在一起。","有控制地伸展双臂回到起始位置。","重复所需的次数。"],"tips":["坐直，膝盖稍微弯曲","将手柄拉至下肋骨处","返回时让肩胛骨向前伸展","保持躯干直立，尽量减少晃动。","将肘部向后伸直，而不是向两侧伸出。","在拉力结束时将肩胛骨挤压在一起。"],"gif":"images/flat/seated-cable-row-peak.webp","thumb":"images/flat/seated-cable-row-start.webp","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/seated-cable-row.mp4","localThumb":"vthumb_seated-cable-row"},{"id":"machine-t-bar-row","name":"Chest-Supported T-Bar Row","nameZH":"俯卧器械 T 杆划船","bodyPart":"back","equipment":"leverage machine","target":"rhomboids","secondary":["latissimus_dorsi","biceps_brachii"],"steps":["胸部留在垫子上","将肘部向后推过躯干","暂停并挤压肩胛骨"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/rhomboids.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/machine-t-bar-row.mp4","localThumb":"vthumb_machine-t-bar-row"},{"id":"barbell-row","name":"Bent-Over Barbell Row","nameZH":"俯身杠铃划船","bodyPart":"back","equipment":"barbell","target":"latissimus_dorsi","secondary":["biceps_brachii","posterior_deltoid"],"steps":["膝盖轻微弯曲，铰接在臀部。","握住杠铃，握距稍宽于肩宽。","将杠铃拉至下胸部，挤压肩胛骨。","有控制地降低杠铃。","重复。"],"tips":["铰链至约 45 度，平背","将杠铃划至肚脐处","降低但不丢失铰链","保持躯干大约 45 度。","不要利用动量来摆动重物。"],"gif":"images/flat/barbell-row-peak.webp","thumb":"images/flat/barbell-row-start.webp","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/bent-over-row.mp4","localThumb":"vthumb_bent-over-row"},{"id":"lat-pulldown","name":"Lat Pulldown","nameZH":"高位下拉","bodyPart":"back","equipment":"cable","target":"latissimus_dorsi","secondary":["biceps_brachii","posterior_deltoid","rhomboids"],"steps":["坐在高位下拉机前，将大腿固定在护垫下。","正手握住宽杆。","将杠铃向下拉至上胸部，挤压背阔肌。","慢慢地将杠铃返回到起始位置。","重复。"],"tips":["紧握肩膀外侧","将杠铃拉至上胸部","控制杆一直向上","将肘部向下和向后推，而不是用手拉。","避免向后倾斜或利用动量来移动重物。","保持胸部抬起，肩膀向下，远离耳朵。"],"gif":"images/flat/lat-pulldown-peak.webp","thumb":"images/flat/lat-pulldown-start.webp","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/lat-pull-down.mp4","localThumb":"vthumb_lat-pull-down"},{"id":"pull-up","name":"Pull-Up","nameZH":"宽距引体向上","bodyPart":"back","equipment":"pull up bar","target":"latissimus_dorsi","secondary":["biceps_brachii","posterior_deltoid","rhomboids"],"steps":["正手握住杠铃，握距略宽于肩宽。","把自己拉起来，直到下巴越过横杆。","在控制下将自己降低到静止状态。","重复。"],"tips":["从静止悬挂开始","将胸部拉向杠铃","每次代表一路降低","避免摇摆或甩动。","将肘部向下拉，以收紧背阔肌。"],"gif":"images/flat/pull-up-peak.webp","thumb":"images/flat/pull-up-start.webp","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/wide-grip-pull-up.mp4","localThumb":"vthumb_wide-grip-pull-up"},{"id":"straight-arm-pulldown","name":"Straight-Arm Pulldown","nameZH":"直臂绳索下拉","bodyPart":"back","equipment":"cable","target":"latissimus_dorsi","secondary":["posterior_deltoid","triceps_brachii"],"steps":["面向绳索机站立，并在高滑轮上连接一根直杆。","双臂几乎伸直，将杠铃沿弧线向下推向大腿。","在底部挤压你的背阔肌。","慢慢地将杠铃返回到起始位置。","重复。"],"tips":["手臂几乎伸直，轻微铰链","将杠铃向下扫至大腿","感受背阔肌，而不是肱三头肌","保持肘部轻微弯曲，但不要将动作变成下压。","稍微铰接臀部并保持背部平坦。","避免利用身体动量向下摆动杠铃。"],"gif":"images/flat/straight-arm-pulldown-peak.webp","thumb":"images/flat/straight-arm-pulldown-start.webp","muscleImage":"images/muscles/latissimus-dorsi.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/straight-arm-lat-pull-down.mp4","localThumb":"vthumb_straight-arm-lat-pull-down"},{"id":"superman","name":"Superman","nameZH":"俯卧超人背伸","bodyPart":"back","equipment":"body weight","target":"erector_spinae","secondary":["hamstrings"],"steps":["脸朝下躺下，双臂伸过头顶。","同时将手臂、胸部和腿抬离地板。","在顶部短暂保持。","下降得到控制。","重复。"],"tips":["脸朝下躺下，双臂伸展","并拢手臂和腿","在最高点保持两秒","举起时挤压臀部。","避免猛烈的动作。"],"gif":"images/flat/superman-peak.webp","thumb":"images/flat/superman-start.webp","muscleImage":"images/muscles/erector-spinae.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/superman.mp4","localThumb":"vthumb_superman"},{"id":"plank","name":"Forearm Plank","nameZH":"标准平板支撑","bodyPart":"waist","equipment":"body weight","target":"rectus_abdominis","secondary":["obliques","erector_spinae"],"steps":["双肘垂直放在肩部正下方支撑在垫面上，前臂平行，双脚前脚掌点地。","收紧腹部、夹紧臀部并推开肩胛，让头、背、臀、腿保持一条紧绷水平直线。","维持均匀深呼吸对抗重力稳定核心，避免塌腰或抬高臀部。"],"tips":["想象把肚脐拉向脊柱并用力夹臀","眼睛看双手之间保持颈椎中立"],"gif":"","thumb":"","muscleImage":"images/muscles/rectus-abdominis.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/plank.mp4","localThumb":"vthumb_plank"},{"id":"hanging-leg-raise","name":"Hanging Leg Raise","nameZH":"单杠悬垂举腿","bodyPart":"waist","equipment":"pull up bar","target":"rectus_abdominis","secondary":["hip_flexors","obliques"],"steps":["双手略宽于肩正握单杠垂直悬垂，双腿并拢伸直，下沉肩部稳定身体。","保持上身不前后甩动，下腹发力将双腿向前上方抬起至水平或更高并微卷骨盆。","最高点控制停顿后缓慢下放双腿回到垂直悬垂位。"],"tips":["结尾轻微向后卷动骨盆才能真正刺激下腹而非仅练髂腰肌","下放时控制速度防止身体摇晃"],"gif":"","thumb":"","muscleImage":"images/muscles/rectus-abdominis.webp","difficulty":"advanced","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/hanging-leg-raise.mp4","localThumb":"vthumb_hanging-leg-raise"},{"id":"russian-twist","name":"Russian Twist","nameZH":"坐姿俄罗斯转体","bodyPart":"waist","equipment":"dumbbell","target":"obliques","secondary":["rectus_abdominis","hip_flexors"],"steps":["坐在训练垫上，上身挺胸后倾约 45° 呈 V 字核心平衡姿，双脚微抬离地。","双手合持一只哑铃于胸前，腹斜肌发力带动肩部与躯干交替向左右两侧扭转。","保持下肢稳定不随躯干大幅摆动，流畅控制左右节奏。"],"tips":["扭转的是胸椎和肩膀，不要只甩手臂","若平衡困难可先将双脚轻点地面"],"gif":"","thumb":"","muscleImage":"images/muscles/obliques.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/russian-twist.mp4","localThumb":"vthumb_russian-twist"},{"id":"sit-up","name":"Sit-Up","nameZH":"仰卧起坐","bodyPart":"waist","equipment":"body weight","target":"rectus_abdominis","secondary":[],"steps":["双脚固定，膝盖弯曲","一次卷起一根椎骨","慢慢降低到地板上"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/rectus-abdominis.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/sit-up.mp4","localThumb":"vthumb_sit-up"},{"id":"lying-leg-raise","name":"Lying Leg Raise","nameZH":"仰卧直腿上举","bodyPart":"waist","equipment":"body weight","target":"hip_flexors","secondary":["obliques","transverse_abdominis"],"steps":["平躺，双腿伸直，双手放在下背部下方或抓住头后的稳定表面。","双腿并拢并支撑核心，将其抬高至垂直位置（或灵活性允许的最高高度）。","在顶部短暂停顿。","慢慢地将双腿放低到地板上，不要让它们接触。","重复所需的次数。"],"tips":["将下背部压入地板","将伸直的腿抬高至垂直位置","降低直至略高于地板","将您的下背部始终压入地板以保护腰椎。","避免摇摆——控制下降以最大程度地增加张力。","如果腿筋灵活性是限制因素，请稍微弯曲膝盖。"],"gif":"images/flat/lying-leg-raise-peak.webp","thumb":"images/flat/lying-leg-raise-start.webp","muscleImage":"images/muscles/hip-flexors.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/lying-floor-leg-raise.mp4","localThumb":"vthumb_lying-floor-leg-raise"},{"id":"weighted-crunch","name":"Weighted Plate Crunch","nameZH":"负重卷腹","bodyPart":"waist","equipment":"plates","target":"rectus_abdominis","secondary":[],"steps":["将板放在胸前","将肋骨向臀部方向挤压","在最高处用力呼气"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/rectus-abdominis.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/weighted-crunch.mp4","localThumb":"vthumb_weighted-crunch"},{"id":"tall-kneeling-cable-lift","name":"Kneeling Cable Lift","nameZH":"高跪姿绳索斜上提拉","bodyPart":"waist","equipment":"cable","target":"obliques","secondary":["rectus_abdominis"],"steps":["膝盖高，臀部方","将绳子斜拉过身体","返回途中抵制旋转"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/obliques.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/tall-kneeling-cable-lift.mp4","localThumb":"vthumb_tall-kneeling-cable-lift"},{"id":"tall-kneeling-cable-chop","name":"Kneeling Cable Chop","nameZH":"高跪姿绳索劈砍伐木","bodyPart":"waist","equipment":"cable","target":"obliques","secondary":["rectus_abdominis"],"steps":["从一侧高处开始","把身体砍下来","保持臀部朝前"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/obliques.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/tall-kneeling-cable-chop.mp4","localThumb":"vthumb_tall-kneeling-cable-chop"},{"id":"split-stance-cable-lift","name":"Split-Stance Cable Lift","nameZH":"分腿站姿绳索斜上拉","bodyPart":"waist","equipment":"cable","target":"obliques","secondary":["gluteus_maximus"],"steps":["窄分叉站姿","从低到高举起整个身体","通过前脚保持平衡"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/obliques.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/split-stance-cable-lift.mp4","localThumb":"vthumb_split-stance-cable-lift"},{"id":"romanian-deadlift","name":"Romanian Deadlift","nameZH":"罗马尼亚硬拉","bodyPart":"upper legs","equipment":"barbell","target":"hamstrings","secondary":["gluteus_maximus","erector_spinae"],"steps":["双脚与髋同宽直立手持杠铃置于大腿前，膝盖微屈约 10–15° 并保持该角度固定。","背部保持平直，纯粹将臀部向后大幅推挤，让杠铃贴着大腿前侧下放至膝下小腿中段。","感受腘绳肌充分拉伸后，夹紧臀部发力伸髋站回直立起始位。"],"tips":["重点在于臀部向后水平铰链而非弯腰低头","小腿全程保持近乎垂直地面"],"gif":"","thumb":"","muscleImage":"images/muscles/hamstrings.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/romanian-deadlift.mp4","localThumb":"vthumb_romanian-deadlift"},{"id":"bulgarian-split-squat","name":"Bulgarian Split Squat","nameZH":"哑铃保加利亚分腿蹲","bodyPart":"upper legs","equipment":"dumbbell","target":"quadriceps","secondary":["gluteus_maximus","hamstrings"],"steps":["背对平板凳站立，前脚稳踩前方地板，后脚脚背轻搭在凳面上，双手持哑铃自然下垂。","核心收紧、上身微前倾，弯曲前腿将后膝垂直向地面下沉至前大腿与地面平行。","前脚掌发力蹬起身体回到高处起始位置。"],"tips":["前脚站距适中，下蹲时前膝朝向脚尖方向","后脚仅作辅助平衡，发力主力在前腿"],"gif":"","thumb":"","muscleImage":"images/muscles/quadriceps.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/bulgarian-split-squat.mp4","localThumb":"vthumb_bulgarian-split-squat"},{"id":"leg-extension","name":"Seated Leg Extension","nameZH":"坐姿器械腿屈伸","bodyPart":"upper legs","equipment":"leverage machine","target":"quadriceps","secondary":[],"steps":["端坐调整靠背使膝关节与器械轴心对齐，脚踝前侧卡在滚轴垫下，双手抓紧侧扶手。","臀部紧贴座椅不动，股四头肌发力将双小腿向前上方踢直。","在完全伸直位顶峰挤压 1 秒，随后缓慢受控下放回 90 度屈膝位。"],"tips":["全程臀部压紧座椅不借力抬起","下放快到起点前保持张力不要让配重片撞底"],"gif":"","thumb":"","muscleImage":"images/muscles/quadriceps.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/yuanyeye0210-debug/stride-app@main/media/videos/leg-extension.mp4","localThumb":"vthumb_leg-extension"},{"id":"barbell-hip-thrust","name":"Barbell Hip Thrust","nameZH":"杠铃臀推","bodyPart":"upper legs","equipment":"barbell","target":"gluteus_maximus","secondary":["hamstrings"],"steps":["上背部位于训练凳边缘，杠铃位于臀部上方","通过脚后跟推动髋部完全伸展","下巴收紧，肋骨位于顶部"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/gluteus-maximus.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/barbell-hip-thrust.mp4","localThumb":"vthumb_barbell-hip-thrust"},{"id":"back-extension","name":"Back Extension","nameZH":"罗马椅背屈伸（山羊挺身）","bodyPart":"back","equipment":"body weight","target":"erector_spinae","secondary":["gluteus_maximus","hamstrings"],"steps":["面朝下躺在过度伸展的训练凳上，臀部位于垫子边缘。","将上半身向地板降低。","向后抬起躯干，直到身体伸直。","重复。"],"tips":["臀部折痕下方的衬垫","铰链向下，背部平坦","上升直至身体形成一条线","保持动作受控。","不要过度伸展超过脊柱中立位。"],"gif":"images/flat/back-extension-peak.webp","thumb":"images/flat/back-extension-start.webp","muscleImage":"images/muscles/erector-spinae.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/hyperextension.mp4","localThumb":"vthumb_hyperextension"},{"id":"good-morning","name":"Good Morning","nameZH":"杠铃早安式体前屈","bodyPart":"upper legs","equipment":"barbell","target":"erector_spinae","secondary":[],"steps":["站立，将杠铃放在上背部。","铰接臀部，将其向后推，同时保持背部平坦。","降低你的躯干，直到它几乎与地板平行。","向前推动臀部以恢复站立状态。","重复。"],"tips":["杠铃位于上背部，膝盖柔软","将臀部向后推，直到躯干接近平行","通过挤压臀部肌群站起来","从灯条开始，先掌握铰链。","整个过程中保持膝盖轻微弯曲。","如果您的下背部开始弯曲，请停止下降。"],"gif":"images/flat/good-morning-peak.webp","thumb":"images/flat/good-morning-start.webp","muscleImage":"images/muscles/erector-spinae.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/good-mornings.mp4","localThumb":"vthumb_good-mornings"},{"id":"barbell-back-squat","name":"Barbell Back Squat","nameZH":"杠铃颈后深蹲","bodyPart":"upper legs","equipment":"barbell","target":"quadriceps","secondary":["gluteus_maximus","adductors"],"steps":["下降前做好支撑","膝盖越过脚趾","整个脚向上驱动"],"tips":[],"gif":"","thumb":"","muscleImage":"images/muscles/quadriceps.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/barbell-back-squat.mp4","localThumb":"vthumb_barbell-back-squat"},{"id":"leg-press","name":"Leg Press","nameZH":"器械倒蹬腿举","bodyPart":"upper legs","equipment":"leverage machine","target":"gluteus_maximus","secondary":["hamstrings"],"steps":["坐在压腿机上，双脚分开与肩同宽，放在平台上。","松开安全锁并弯曲膝盖降低平台。","将平台向后推，直到腿几乎伸直。","不要在顶部锁住膝盖。","重复。"],"tips":["双脚与肩同宽，平台位于中间","降低直到膝盖达到约90度","不要在顶部锁住膝盖","将您的下背部和臀部压入座椅。","尽可能降低臀部，但不要将臀部卷入下方。","均匀地穿过整个脚，而不仅仅是脚趾。"],"gif":"images/flat/leg-press-peak.webp","thumb":"images/flat/leg-press-start.webp","muscleImage":"images/muscles/gluteus-maximus.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/leg-press.mp4","localThumb":"vthumb_leg-press"},{"id":"hack-squat","name":"Hack Squat","nameZH":"哈克深蹲","bodyPart":"upper legs","equipment":"leverage machine","target":"gluteus_maximus","secondary":["gastrocnemius","hamstrings"],"steps":["装载哈克深蹲机并踏上，将背部和肩膀靠在垫子上。","将双脚与肩同宽放在平台上，脚趾稍微向外。","解锁安全手柄并弯曲膝盖和臀部降低雪橇。","下降直到大腿至少与平台平行。","通过脚后跟推动双腿并将雪橇推回起点。","最后一次完成后重新接合安全手柄。"],"tips":["背部平贴在垫子上","深入控制","穿过脚中部","在整个运动过程中，保持下背部压在垫子上。","将脚放在平台上较高的位置会将重点转移到臀部肌群和腿筋上。","控制下降；不要从底部位置反弹。"],"gif":"images/flat/hack-squat-peak.webp","thumb":"images/flat/hack-squat-start.webp","muscleImage":"images/muscles/gluteus-maximus.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/machine-hack-squat.mp4","localThumb":"vthumb_machine-hack-squat"},{"id":"stability-ball-wall-squat","name":"Stability Ball Wall Squat","nameZH":"瑞士球靠墙静蹲","bodyPart":"upper legs","equipment":"stability ball","target":"gluteus_maximus","secondary":["hamstrings"],"steps":["在下背部和墙壁之间放置一个稳定球。","双脚向前迈出约一英尺，略宽于肩宽。","蹲下，下降时让球从背部滚动。","当大腿与地面平行时停止。","穿过脚后跟站起来。"],"tips":["球位于下背部和墙壁之间","蹲下，让球跟着你滚动","站直并挤压臀部肌群","将重量保持在脚后跟和中足。","不要让膝盖超过脚趾。","球应该平稳滚动——不要倾斜。"],"gif":"images/flat/stability-ball-wall-squat-peak.webp","thumb":"images/flat/stability-ball-wall-squat-start.webp","muscleImage":"images/muscles/gluteus-maximus.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/exercise-ball-wall-squat.mp4","localThumb":"vthumb_exercise-ball-wall-squat"},{"id":"stiff-leg-deadlift","name":"Stiff Leg Deadlift","nameZH":"直腿杠铃硬拉","bodyPart":"back","equipment":"barbell","target":"gluteus_maximus","secondary":["erector_spinae","trapezius"],"steps":["双脚分开站立，与臀部同宽，铰接在臀部，双腿几乎伸直，将杠铃低放在小腿前，背部平坦。","保持双腿几乎伸直，全程仅轻微弯曲膝盖。","向前推动臀部并直立，杠铃沿着双腿移动。","再次铰接臀部并沿着腿部降低杠铃。","在你的腿筋灵活性允许的情况下，在背部平坦的情况下尽可能降低高度。","重复所需的次数。"],"tips":["膝盖柔软，杠铃靠近腿部","铰链直到感觉到腿筋强烈拉伸","通过向前推动臀部来返回","将臀部向后推，并使杠铃靠近腿部。","仅在平坦背部允许的范围内深度。","感受腿筋在伸展过程中的负荷，然后推动臀部向前站立。"],"gif":"images/flat/stiff-leg-deadlift-peak.webp","thumb":"images/flat/stiff-leg-deadlift-start.webp","muscleImage":"images/muscles/gluteus-maximus.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/stiff-leg-deadlift.mp4","localThumb":"vthumb_stiff-leg-deadlift"},{"id":"seated-leg-curl","name":"Seated Leg Curl","nameZH":"坐姿器械腿弯举","bodyPart":"upper legs","equipment":"leverage machine","target":"hamstrings","secondary":["gastrocnemius"],"steps":["调整座椅靠背和脚踝垫，使膝盖与机器的枢轴点对齐。","坐直，将脚踝后部放在垫子上，并握住手柄。","在机器允许的范围内，将小腿向下并向后弯曲到座椅下方。","在收缩峰值时暂停，然后缓慢地将重量返回到起始位置。","重复所需的次数。"],"tips":["将膝盖与机器枢轴对齐","将垫子弯举到座椅下方","缓慢返回，保持紧张","在整个运动过程中，保持背部牢牢靠在靠背上。","在收缩峰值时，将脚趾稍微指向小腿，以增加腿筋的激活。","控制偏心阶段——不要让重量将双腿快速拉回。"],"gif":"images/flat/seated-leg-curl-peak.webp","thumb":"images/flat/seated-leg-curl-start.webp","muscleImage":"images/muscles/hamstrings.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/seated-leg-curl.mp4","localThumb":"vthumb_seated-leg-curl"},{"id":"ball-leg-curl","name":"Stability Ball Leg Curl","nameZH":"瑞士球仰卧腿弯举","bodyPart":"upper legs","equipment":"stability ball","target":"hamstrings","secondary":["gastrocnemius","gluteus_maximus"],"steps":["面朝上躺在地板上，脚后跟和小腿下部放在稳定球上，手臂伸出以保持平衡。","压过脚后跟，将臀部抬高，从肩膀到脚踝成一条直线。","保持臀部向上，弯曲膝盖将球滚向臀部。","在有控制的情况下将腿向后伸展，不要降低臀部。","完成所有次数，然后降低臀部并离开球。"],"tips":["脚跟放在球上，臀部抬起","将球向臀部肌群方向弯举","全程保持臀部向上","整组动作中臀部保持抬起——这是桥式加弯举的组合。","从双脚开始；当变得容易时，进展到单腿。"],"gif":"images/flat/ball-leg-curl-peak.webp","thumb":"images/flat/ball-leg-curl-start.webp","muscleImage":"images/muscles/hamstrings.webp","difficulty":"intermediate","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/exercise-ball-leg-curl.mp4","localThumb":"vthumb_exercise-ball-leg-curl"},{"id":"nordic-hamstring-curl","name":"Nordic Hamstring Curl","nameZH":"北欧腘绳肌弯举","bodyPart":"upper legs","equipment":"leverage machine","target":"hamstrings","secondary":["gastrocnemius","gluteus_maximus"],"steps":["跪在垫子上，脚踝固定在固定支撑物下。","保持躯干直立，臀部伸展。","用腿筋抵抗，慢慢向前降低身体。","在撞到地板之前用手抓住自己。","向后推并将自己拉回到起始位置。","重复所需的次数。"],"tips":["跪下，脚踝固定","尽可能缓慢地向前降低身体","用手抓住，向上推","尽可能缓慢地下降——偏心是重点。","保持臀部伸展；不要折叠腰部。","用手抓住自己并轻轻推开，同时增强力量。"],"gif":"images/flat/nordic-hamstring-curl-peak.webp","thumb":"images/flat/nordic-hamstring-curl-start.webp","muscleImage":"images/muscles/hamstrings.webp","difficulty":"advanced","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/nordic-hamstring-curl.mp4","localThumb":"vthumb_nordic-hamstring-curl"},{"id":"standing-calf-raise","name":"Standing Calf Raise","nameZH":"站姿器械提踵","bodyPart":"lower legs","equipment":"leverage machine","target":"gastrocnemius","secondary":["soleus"],"steps":["站在平台或提腿机的边缘。","将鞋跟放低至平台下方。","向上推你的脚趾。","慢慢降低。","重复。"],"tips":["脚掌在边缘","尽可能上升","降低至完全伸展","在顶部暂停以最大限度地收缩。","足跟高度下降可增加运动范围。"],"gif":"images/flat/standing-calf-raise-peak.webp","thumb":"images/flat/standing-calf-raise-start.webp","muscleImage":"images/muscles/gastrocnemius.webp","difficulty":"beginner","video":"https://cdn.jsdelivr.net/gh/namnq/workout-free-videos@v2.0.0/media/video/standing-machine-calf-raise.mp4","localThumb":"vthumb_standing-machine-calf-raise"},{"id":"seated-calf-raise","name":"Seated Calf Raise","nameZH":"坐姿器械提踵","bodyPart":"lower legs","equipment":"leverage machine","target":"soleus","secondary":["gastrocnemius"],"steps":["坐在提踵机前，将垫子放在大腿上。","尽可能降低脚后跟。","抬起你的脚趾。","下降得到控制。","重复。"],"tips":["垫子紧贴膝盖上方","通过大脚趾向上推举","拉伸时暂停","弯曲的膝盖使腓肠肌松弛，因此比目鱼肌承担更多的工作。","使用全方位的运动。"],"gif":"images/flat/seated-calf-raise-peak.webp","thumb":"images/flat/seated-calf-raise-start.webp","muscleImage":"images/muscles/soleus.webp","difficulty":"beginner","video":"https://cdn.jsde